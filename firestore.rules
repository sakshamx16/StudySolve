rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function
    function isSignedIn() {
      return request.auth != null;
    }

    // Users profile
    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId);
    }

    // Study groups
    match /study_groups/{groupId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && (
        resource.data.createdByUid == request.auth.uid ||
        resource.data.createdByUid == null
      );
    }

    // Questions and study materials
    match /materials/{materialId} {
      allow read: if true;
      allow create: if isSignedIn();
      // Allow updating solutionsCount, isSolved, ratings
      allow update: if isSignedIn();
      // Allow author to delete question if posted mistakenly (or demo questions)
      allow delete: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        resource.data.author.uid == request.auth.uid ||
        resource.data.authorUid == null ||
        resource.data.authorUid == ''
      );
    }

    // Solutions posted by students
    match /solutions/{solutionId} {
      allow read: if true;
      allow create: if isSignedIn();
      // Allow updating reviews, ratings, votes
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        resource.data.author.uid == request.auth.uid ||
        resource.data.authorUid == null
      );
    }
  }
}
