rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function
    function isSignedIn() {
      return request.auth != null;
    }

    // Users profile
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Study groups (open and collaborative for peer learning)
    match /study_groups/{groupId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Questions and study materials
    match /materials/{materialId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Solutions posted by students
    match /solutions/{solutionId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }
  }
}
